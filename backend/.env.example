# ── Required ──  (MONGO_URI zaroori; API key optional)
# Claude key na ho to khali chhod do — bot Demo mode me chalega
ANTHROPIC_API_KEY=
MONGO_URI=mongodb://127.0.0.1:27017/chatbot

# ── Optional ──
# Default model (dashboard → Bot settings se bhi badal sakte ho)
CLAUDE_MODEL=claude-sonnet-5-5
PORT=5000
# Dashboard me login nahi hai, isliye backend sirf is computer par sunta hai.
# Server par deploy karne se pehle login add karna, phir HOST=0.0.0.0
HOST=127.0.0.1
# Dashboard (frontend) ka URL
CLIENT_ORIGIN=http://localhost:5173
# Website par khulne wala chat iframe
WIDGET_URL=http://localhost:5173/widget/chat
# Login tokens ka secret (online deploy par zaroor daalo; khali ho to DB me apne aap banta hai)
JWT_SECRET=
# Built-in lead MCP server ka path (sirf pehli baar seed ke liye)

# ── Free API (koi bhi OpenAI-compatible service: Groq, Gemini, OpenRouter…) ──
# Key yahan, URL aur model dashboard → Bot settings → "Free API" se bhi badal sakte ho
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# ── Bina API key ke (free) ──
# Dashboard → Bot settings → AI provider: Demo (koi AI nahi, fixed flow)

# ── Meeting booking (appointments MCP server) — India time ──
# CLOSED_DAYS: 0=Sunday, 1=Monday ... 6=Saturday (comma se kai din: 0,6)
OPEN_TIME=10:00
CLOSE_TIME=19:00
SLOT_MINUTES=30
CLOSED_DAYS=0
MAX_DAYS_AHEAD=30
